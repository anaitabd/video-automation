ENVIRONMENT=development
LOG_LEVEL=INFO
ENABLE_FILE_LOGGING=false
LOG_FILE=app.log
OUTPUT_DIR=output

# Core providers
OPENAI_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL
ELEVENLABS_FALLBACK_VOICE_ID=MF3mGyEYCl7XYWbV9V6O
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
ELEVENLABS_STABILITY=0.5
ELEVENLABS_SIMILARITY_BOOST=0.75
ELEVENLABS_TIMEOUT_SECONDS=60
ELEVENLABS_MAX_RETRIES=3
ELEVENLABS_BASE_RETRY_DELAY_SECONDS=1.5
ELEVENLABS_BACKOFF_MULTIPLIER=2.0
ELEVENLABS_MAX_DELAY_SECONDS=30.0
ELEVENLABS_CIRCUIT_FAILURE_THRESHOLD=5
ELEVENLABS_CIRCUIT_RECOVERY_SECONDS=30.0

PEXELS_API_KEY=
VIDEO_PROVIDER=pexels

# Google Cloud
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
GCS_BUCKET_NAME=
GCS_MAX_RETRIES=3
GCS_RETRY_BASE_DELAY_SECONDS=1.0
GCS_TIMEOUT_SECONDS=60
GCS_CIRCUIT_FAILURE_THRESHOLD=5
GCS_CIRCUIT_RECOVERY_SECONDS=30.0
FIRESTORE_JOBS_COLLECTION=video_jobs

# Script + visuals generation
SCRIPT_MODEL=gemini-2.5-pro
SCRIPT_LANGUAGE=English
SCRIPT_GENERATION_MAX_RETRIES=3
SCRIPT_GENERATION_RETRY_BASE_DELAY_SECONDS=1.0
SCRIPT_GENERATION_TIMEOUT_SECONDS=45
SCRIPT_GENERATION_BACKOFF_MULTIPLIER=2.0
SCRIPT_GENERATION_MAX_DELAY_SECONDS=30.0
SCRIPT_GENERATION_CIRCUIT_FAILURE_THRESHOLD=5
SCRIPT_GENERATION_CIRCUIT_RECOVERY_SECONDS=30.0
VISUALS_MODEL=gemini-2.5-flash

# FFmpeg / rendering
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe
FFMPEG_MAX_RETRIES=3
FFMPEG_RETRY_BASE_DELAY_SECONDS=1.0
FFMPEG_TIMEOUT_SECONDS=180
FFMPEG_MAX_DELAY_SECONDS=30.0
FFMPEG_CIRCUIT_FAILURE_THRESHOLD=5
FFMPEG_CIRCUIT_RECOVERY_SECONDS=30.0
VIDEO_SUBTITLE_PATH=

# Compatibility toggles
VOICE_PROVIDER=elevenlabs
